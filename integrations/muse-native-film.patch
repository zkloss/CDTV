+import base64
+import asyncio
+from unittest.mock import AsyncMock
+
+import pytest
+
+from muse2api.api.schemas import VideoCreateRequest
+from muse2api.drivers.base import InputImage, VideoRequest
+from muse2api.drivers.browser.driver import BrowserDriver
+from muse2api.accounts import Account
+from test_video_endpoints import wait_for_video
+
+
+def test_native_mode_schema():
+    assert VideoCreateRequest(prompt='full story', duration=120, production_mode='scene').duration == 120
+    with pytest.raises(ValueError):
+        VideoCreateRequest(prompt='one shot', duration=120)
+    with pytest.raises(ValueError):
+        VideoCreateRequest(prompt='assemble', production_mode='assemble', videos=[])
+
+
+def test_native_video_upload_round_trip(client, auth, monkeypatch):
+    gateway = client.app.state.services.gateway
+    seen = []
+    original = gateway.generate_video
+    async def record(req):
+        seen.append(req)
+        return await original(req)
+    monkeypatch.setattr(gateway, 'generate_video', record)
+    videos = ['data:video/mp4;base64,' + base64.b64encode(v).decode() for v in [b'clip-a', b'clip-b']]
+    caps = client.get('/v1/video-capabilities', headers=auth).json()
+    assert 'assemble' in caps['production_modes']
+    response = client.post('/v1/videos/generations', headers=auth, json={
+        'prompt':'keep A then B', 'production_mode':'assemble', 'videos':videos})
+    assert response.status_code == 200, response.text
+    task = wait_for_video(client, auth, '/v1/videos/generations', response.json()['id'])
+    assert task['status'] == 'succeeded'
+    assert [v.data for v in seen[0].reference_videos] == [b'clip-a', b'clip-b']
+    metadata = client.app.state.services.tasks.get(task['id']).request
+    assert metadata['reference_video_count'] == 2 and 'base64' not in str(metadata)
+    for bad in ['http://127.0.0.1/private.mp4', 'data:video/mp4;base64,broken!']:
+        response = client.post('/v1/videos', headers=auth, json={
+            'prompt':'assemble', 'production_mode':'assemble', 'videos':[bad, videos[0]]})
+        assert response.status_code == 400
+
+
+@pytest.mark.parametrize('mode', ['scene', 'assemble'])
+def test_native_driver_omits_shot_wrapper(settings, monkeypatch, mode):
+    driver = BrowserDriver(settings)
+    produce = AsyncMock(return_value='result')
+    monkeypatch.setattr(driver, '_generate', produce)
+    source = InputImage(b'clip', 'video/mp4')
+    asyncio.run(driver.generate_video(Account(cookies={}), VideoRequest(
+        prompt='完整原文', model='muse-video', production_mode=mode, reference_videos=[source])))
+    args = produce.call_args.args
+    assert 'one continuous shot' not in args[1] and 'no montage' not in args[1]
+    assert '完整原文' in args[1] and args[2] == [source]
